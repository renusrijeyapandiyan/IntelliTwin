# Copy to .env, or (better) run ./scripts/make-env.sh which generates random values.
JWT_SECRET=<at least 32 random characters>
INGEST_API_KEY=<at least 16 random characters>
AI_API_KEY=<random>
CONTROL_TOKEN=<random, optional>
SEED_ADMIN_PASSWORD=<min 8 chars>
SEED_ENGINEER_PASSWORD=<min 8 chars>
SEED_OPERATOR_PASSWORD=<min 8 chars>
SIM_SEED=42
# optional: LEARN_INTERVAL_SECONDS=600  LEARN_LOOKBACK_HOURS=6
